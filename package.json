{
  "name": "@bankofai/x402-cli",
  "version": "1.0.1-beta.1",
  "type": "module",
  "files": [
    "dist"
  ],
  "bin": {
    "x402-cli": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "bundle:gateway": "node scripts/bundle-gateway.mjs",
    "prepack": "npm run build && npm run bundle:gateway",
    "test": "npm run build && node --test tests/*.test.mjs",
    "start": "node dist/cli.js",
    "dev": "tsx src/cli.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@bankofai/x402-core": "1.0.1-beta.4",
    "@bankofai/x402-evm": "1.0.1-beta.4",
    "@bankofai/x402-gateway": "^1.0.0",
    "@bankofai/x402-tron": "1.0.1-beta.4",
    "tronweb": "6.4.0",
    "viem": "^2.55.0",
    "yaml": "^2.8.2"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
